# EHomeSystem Docker Compose Configuration
# Copy to .env and modify as needed

# PostgreSQL
POSTGRES_USER=ehome
POSTGRES_PASSWORD=ehome123
POSTGRES_DB=ehome
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# EMQX MQTT Broker
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083

# Backend
BACKEND_PORT=8080

# OTA firmware download URL (use LAN IP so ESP32 can reach backend)
EHOME_EXTERNAL_HOST=192.168.20.3:8080

# Optional first-run administrator bootstrap.
# Both username and password are required; password must be at least 8 chars.
# Remove these values after the first successful startup when possible.
# EHOME_ADMIN_USERNAME=admin
# EHOME_ADMIN_PASSWORD=CHANGE_ME_at_least_8_chars
# EHOME_ADMIN_EMAIL=admin@example.com
