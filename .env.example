# EHomeSystem Docker Compose Environment
# Copy to .env and edit values before deploy:  cp .env.example .env

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=ehome
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=ehome
# Host-side port mapping (container always uses 5432 internally)
# POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
# Host-side port mapping (container always uses 6379 internally)
# REDIS_PORT=6379

# ── EMQX MQTT Broker ──────────────────────────────────────────
# Host-side port mappings (container always uses internal ports)
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083

# ── Unified service (frontend + backend in one container) ─────
# Host-side port → container 8080
HOME_PORT=80

# ── Backend: Database ─────────────────────────────────────────
# EHOME_DB_HOST=postgres
# EHOME_DB_PORT=5432
# EHOME_DB_USER=ehome
# EHOME_DB_PASSWORD=CHANGE_ME_strong_password
# EHOME_DB_NAME=ehome
# EHOME_DB_SSLMODE=disable

# ── Backend: MQTT ─────────────────────────────────────────────
# MQTT broker URL
# MQTT_BROKER=tcp://emqx:1883
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT client ID prefix (uniqueness suffix auto-appended)
# EHOME_MQTT_CLIENT_ID=ehome-server

# ── Backend: Redis ────────────────────────────────────────────
# REDIS_ADDR=redis:6379

# ── Backend: HTTP server ─────────────────────────────────────
# EHOME_SERVER_ADDR=:8080

# ── Backend: Static files ────────────────────────────────────
# Directory containing built frontend assets (dist/)
# EHOME_STATIC_DIR=/app/static/dist

# ── Backend: OTA firmware download ───────────────────────────
# External-reachable host:port for firmware URL generation.
# Use LAN IP or domain so ESP32 can reach backend.
EHOME_EXTERNAL_HOST=your-domain.com:80

# ── Backend: JWT ─────────────────────────────────────────────
# HMAC secret for signing JWT tokens (random 64+ char string)
EHOME_JWT_SECRET=CHANGE_ME_random_64_char_string

# ── Backend: CORS ────────────────────────────────────────────
# Comma-separated origin allowlist. Empty = same-origin only (no CORS middleware).
# Only needed when frontend is served from a different origin than backend.
# EHOME_ALLOWED_ORIGINS=https://your-domain.com

# ── Backend: Logging ────────────────────────────────────────
# Log level: debug, info, warn, error
# LOG_LEVEL=info

# ── Backend: Runtime mode ───────────────────────────────────
# GIN_MODE=release
# EHOME_ENV=production

# ── Backend: Config file ────────────────────────────────────
# Path to YAML config file (env vars override file values)
# CONFIG_PATH=config.yaml

# ── First-run administrator bootstrap ───────────────────────
# Set both username and password before first `docker compose up`.
# Password must be at least 8 chars. Server only uses these while
# AuthState is uninitialized; never replaces an existing admin.
# Remove after successful bootstrap.
# EHOME_ADMIN_USERNAME=admin
# EHOME_ADMIN_PASSWORD=CHANGE_ME_at_least_8_chars
# EHOME_ADMIN_EMAIL=admin@example.com
