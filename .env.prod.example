# EHomeSystem Production Environment
# Copy to .env and edit values before deploy

# Database
POSTGRES_USER=ehome
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=ehome

# Unified service port
HOME_PORT=80

# EMQX
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083

# Production config
EHOME_EXTERNAL_HOST=your-domain.com:80
EHOME_JWT_SECRET=CHANGE_ME_random_64_char_string
# CORS origin allowlist (comma-separated). Empty = same-origin only (no CORS middleware).
# Only needed when the frontend is served from a different origin than the backend.
# Example: EHOME_ALLOWED_ORIGINS=https://your-domain.com
