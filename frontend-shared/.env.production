# 生产环境配置
# 部署时通过以下方式覆盖（同名前缀 VITE_ 即可）：
#   1. 部署机器的 /etc/ehomesystem/web.env
#   2. Docker build args: --build-arg VITE_API_BASE_URL=... --build-arg VITE_BASE_PATH=/ehome-dev/
#   3. CI/CD 注入

# API 与 WS 默认走同源（由前端 Nginx/网关反代到后端）
VITE_API_BASE_URL=
VITE_WS_URL=/api/v1/ws

# 子路径前缀部署（反代 /ehome-dev 场景）：
#   设为本应用挂载的子路径（如 /ehome-dev/），构建产物资源、API、WS、登录跳转
#   都会自动带此前缀。默认空 = 根路径部署（无前缀）。必须与反代 location 前缀一致。
#   ⚠️ 必须通过 Docker build args 或 shell 环境变量传入（.env 文件里配 vite.config 读不到）
# VITE_BASE_PATH=/ehome-dev/

# 应用元信息
VITE_APP_NAME=EHomeSystem
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=家庭数字化系统 - IoT 数据采集平台

# 日志上报开关（生产建议开启，集中收集前端错误）
VITE_LOG_REMOTE_ENABLED=false
VITE_LOG_ENDPOINT=/api/v1/logs

# 登录失败策略
VITE_LOGIN_MAX_ATTEMPTS=5
VITE_LOGIN_LOCKOUT_SECONDS=300
