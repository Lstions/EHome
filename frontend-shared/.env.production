# 生产环境配置
# 部署时通过以下方式覆盖（同名前缀 VITE_ 即可）：
#   1. 部署机器的 /etc/ehomesystem/web.env
#   2. Docker build args: --build-arg VITE_API_BASE_URL=... --build-arg VITE_BASE_PATH=/ehome-dev/
#   3. CI/CD 注入

# API 与 WS 默认走同源（由前端 Nginx/网关反代到后端）
VITE_API_BASE_URL=
# VITE_WS_URL 语义（二选一，语义唯一，见 src/stores/websocket.ts）：
#   · 完整端点：以 ws:// 或 wss:// 开头 → 原样使用，不再追加任何路径，
#     也不受 VITE_BASE_PATH 影响。例：VITE_WS_URL=wss://host/api/v1/ws
#     ⚠️ wss://host（不带路径）就是完整端点本身，不会自动补 /api/v1/ws；
#        需要该路径时必须写全：wss://host/api/v1/ws
#   · 相对路径：以 / 开头 → 拼 VITE_BASE_PATH 前缀后基于当前页面 origin 组装，
#     适用于同源反代场景（下方默认值）。
VITE_WS_URL=/api/v1/ws

# 子路径前缀部署（反代 /ehome-dev 场景）：
#   设为本应用挂载的子路径（如 /ehome-dev/），构建产物资源、API、WS、登录跳转
#   都会自动带此前缀。默认空 = 根路径部署（无前缀）。必须与反代 location 前缀一致。
#   ⚠️ 必须通过 Docker build args 或 shell 环境变量传入（.env 文件里配 vite.config 读不到）
# VITE_BASE_PATH=/ehome-dev/

# 应用元信息
#
# ⚠️ 这里**不再写死版本号**（原 VITE_APP_VERSION=2.0.0 已删除）。
# 真实版本只有一个来源：后端 `GET /api/v1/system/version` 的 data.version
# （由 deploy/release.json → buildinfo → go:embed 提供）。前端缺失即显示「未知」，
# 绝不回退到与镜像无关的字符串 —— 那会让侧栏版本永远正确又永远无用。
VITE_APP_NAME=EHomeSystem
VITE_APP_DESCRIPTION=家庭数字化系统 - IoT 数据采集平台

# 构建身份（T2.4）：一般由 CI / Docker build-arg 注入，且必须与后端 buildinfo.BuildID
# **逐字相同**。后端 BuildID 是 **7 位** git short SHA（与 Dockerfile 的
# `GIT_COMMIT` 前 7 位同一条规则）：
#   docker build --build-arg VITE_BUILD_ID=$(git rev-parse --short=7 HEAD) ...
#   docker build --build-arg VITE_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) ...
#
# ⚠️ **长度必须与后端 buildinfo.BuildID 一致（7 位）**。
#    传 12 位（即 --short=12）时，前端 `VITE_BUILD_ID` 永远不等于后端
#    `X-EHome-Build` 响应头里的 7 位值 ⇒ 每个 /api/* 响应都被判成「服务端更新了」，
#    旧页面会**常驻**「系统已发布新版本」横幅，点「立即刷新」也不会消失。
#    前端不做任何截断/补全（那是刻意的：静默修正会掩盖 CI 传错，问题会以更难排查的
#    方式出现在用户脸上）。长度不一致时请改 CI，而不是改前端。
#
# 本地 `vite build` 未显式传值时由 vite.config.ts 兜底推导，无需在此配置。
# VITE_BUILD_ID=
# VITE_BUILD_TIME=

# 日志上报开关（生产建议开启，集中收集前端错误）
VITE_LOG_REMOTE_ENABLED=false
VITE_LOG_ENDPOINT=/api/v1/logs

# 登录失败策略
VITE_LOGIN_MAX_ATTEMPTS=5
VITE_LOGIN_LOCKOUT_SECONDS=300
