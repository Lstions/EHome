# EHomeSystem Development Environment
# 用法:  docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up -d

# 基础设施 (与生产共用 .env 变量)
POSTGRES_USER=ehome
POSTGRES_PASSWORD=ehome123
POSTGRES_DB=ehome
POSTGRES_PORT=5432
REDIS_PORT=6379
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083

# 后端端口
BACKEND_PORT=8080

# 前端开发端口 (Vite HMR)
FRONTEND_DEV_PORT=5174

# Vite proxy target (容器内部 DNS)
VITE_API_TARGET=http://backend:8080