# EHomeSystem Development Environment
# 用法: docker compose --project-name ehome-dev --env-file .env.dev -f docker-compose.dev.yml up -d

# 开发与测试共用这一套基础设施，但不与生产环境共享容器、网络或卷
COMPOSE_PROJECT_NAME=ehome-dev
POSTGRES_USER=ehome
POSTGRES_PASSWORD=ehome123
POSTGRES_DB=ehome
POSTGRES_PORT=5435
REDIS_PORT=6380
EMQX_MQTT_PORT=1884
EMQX_WS_PORT=8084
EMQX_DASHBOARD_PORT=18084

# 后端端口
BACKEND_PORT=8082

# 前端开发端口 (Vite HMR)
FRONTEND_PORT=5174

# Vite proxy target（前后端均运行在本机）
VITE_API_TARGET=http://localhost:8082
