backend/coverage.out
backend/api_cover.out
backend/cover.out

# 临时调试产物（执行者的探针/草稿，不应入库）
# 为什么必须显式忽略：本轮多个执行者会在仓库内就地写探针脚本与调试 spec
# （.tmp-probe/、__dbg_*.spec.ts、_tmp-*.mjs 等），若不加规则会随 `git add -A` 混入提交。
# 约定：可复用的工具放 tools/ 并入库（如 uiux-audit.mjs）；一次性的草稿放这些目录。
frontend-shared/.tmp-probe/
.tmp-probe/
**/__dbg_*
**/_tmp-*
**/__scratch_*
backend/coverage_raw.out
coverage.out
frontend-shared/coverage/

# Local ESP32 host-test build trees
esp32-collector/host_tests/build*/

# AI agent local files
.hermes/
.claude/

# Python venv for screenshot tooling
scripts/.venv/

# Screenshot artifacts (generated by scripts/screenshot_all_pages.py)
screenshots/

# Dev environment with secrets — never commit
.env.dev
agents/
backend/f6-env-dev.env

# Git worktrees
.worktrees/

# 数据库备份产物（pg_dump/校验文件，不入库）
backups/
*.dump

# 执行者一次性探针/草稿（本轮新增，2026-09-13 第九轮）
# 为什么扩这条规则：本轮多个子代理即使被要求「探针放 .tmp-probe/」，仍在
# frontend-shared/ 根下就地写了 tmp-probe2.mjs / varprobe.tmp.mjs / .audit-tokens.mjs 等文件。
# 约定：可复用的工具放 frontend-shared/tools/ 并入库；一次性草稿必须落在下面这些模式里。
frontend-shared/*.tmp.mjs
frontend-shared/*-probe*.mjs
frontend-shared/*varprobe*.mjs
frontend-shared/*-vp*.mjs
frontend-shared/.*-tokens.mjs
frontend-shared/.f16-before.mjs
**/*.tmp.mjs
**/__probe.spec.ts
