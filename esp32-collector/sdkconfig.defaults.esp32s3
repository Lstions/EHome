# EHomeSystem ESP32-S3 specific configuration
# Target
CONFIG_IDF_TARGET="esp32s3"

# USB Serial/JTAG (S3 native USB: GPIO19=D-, GPIO20=D+)
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y

# S3 has 3 UARTs, all DMA-capable
# UART0 (TX43/RX44): user data serial + ROM download fallback
# UART1 (TX20/RX21): CH340 dev board
# UART2 (TX1/RX2):   general purpose

# PSRAM：按型号区分。**本文件（s3-n8/s3-n16）保持关闭**；
# 带 PSRAM 的型号 s3p-* 在 sdkconfig.defaults.esp32s3psram 中开启。
#
# 历史（2026-10-04/05，必须保留）：S3 板上确有 8MB 嵌入式 PSRAM
# （esptool 报 "Embedded PSRAM 8MB (AP_3v3)"），曾经因为两个现场故障
# （OTA 任务 8KB 栈创建失败；ConfigManifest 事务需要约 16KB，apply 峰值
# 只剩数百字节）尝试开启。当时立即可见的问题是：
#
#   开 CONFIG_SPIRAM → IDF 置上 CONFIG_STDATOMIC_S32C1I_SPIRAM_WORKAROUND
#   （esp_libc/Kconfig:212，默认 SPIRAM && (ESP32||ESP32S3) && !CLANG）
#   → esp_libc/project_include.cmake:55-58 给**全部**编译单元加
#     -mdisable-hardware-atomics
#   → ATOMIC_INT_LOCK_FREE 由 2 降 1
#   → main/hello_handshake_runtime.h 的全局硬门禁 #error
#     "Hello callbacks require always-lock-free 32-bit integer atomics"
#
# 根因是 Xtensa 的 S32C1I 原子指令**只在内部 RAM 有效**，PSRAM 地址上
# 不成立，IDF 只能全局禁用硬件原子避免静默数据竞争。但这不是"PSRAM 与
# 无锁原子二选一"：IDF 自己对 src/port/xtensa/stdatomic_s32c1i.c 用
# -mno-disable-hardware-atomics 精确豁免（esp_libc/CMakeLists.txt:129-131），
# 这正是本项目的复用模式。
#
# 现在的方案（s3p 型号）：
#   * main/hello_handshake_runtime.c 单 TU 恢复硬件原子
#     （main/CMakeLists.txt，仅当 STDATOMIC_S32C1I_SPIRAM_WORKAROUND=y）；
#   * main/hello_handshake.c 的 s_runtime 用 DRAM_ATTR 钉在内部 RAM，
#     并在初始化时断言地址不在 [SOC_EXTRAM_DATA_LOW, SOC_EXTRAM_DATA_HIGH)；
#   * 其他 TU 仍为 ATOMIC_INT_LOCK_FREE=1，IDF 按地址走临界区分支
#     （esp_stdatomic.h:55），语义正确。
#
# 因此：s3-n8/s3-n16 默认不开 PSRAM（本文件无 CONFIG_SPIRAM=y）；
# s3p-* 通过 sdkconfig.defaults.esp32s3psram 开启。若将来把无 PSRAM 的
# s3 型号也切到 PSRAM，必须同时确认 s_runtime 的 DRAM_ATTR 与实现 TU 的
# 豁免仍然生效。

# 16MB flash + 16MB 分区表（ota_0/ota_1 各 0x680000）。
#
# 为什么必须写进 committed defaults：这两项以前只存在于本地 sdkconfig，
# 而 sdkconfig 是 gitignored 的（仓库根 .gitignore:14）。后果：
#   1. 任何人跑一次 `idf.py set-target esp32s3` 就会把它重置回 2MB 默认值，
#      构建直接失败 —— "Partitions tables occupies 3.6MB of flash which
#      does not fit in configured flash size 2MB"（2026-10-04 实际发生）；
#   2. 从仓库无法复现产线固件 —— 同一份代码在不同机器上产出不同分区表，
#      OTA 镜像上限与可用升级空间随之不同。
# 这两项属于"产品形态"而非"个人偏好"，因此随代码走。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_s3_16m.csv"
