menu "EHome MQTT Configuration"

    config COLLECTOR_MQTT_BROKER_URL
        string "MQTT Broker URL"
        default "mqtt://192.0.2.1:1883"
        help
            MQTT broker URL for communication.
            Format: mqtt://host:port or mqtts://host:port

            The default is a placeholder, not a deployment: 192.0.2.0/24 is
            TEST-NET-1 (RFC 5737), reserved for documentation and guaranteed
            unroutable.  A firmware built without an explicit broker therefore
            cannot reach anything, which fails visibly instead of silently
            connecting to an unintended host.

            Set the real broker via config/mqtt-broker.defaults (gitignored;
            see config/mqtt-broker.defaults.example) or by passing
            EXTRA_SDKCONFIG_DEFAULTS to ./build_firmware.sh.

            This value is compiled in.  There is no NVS or runtime override.

    config COLLECTOR_NODE_ID
        string "Node ID"
        default "1001"
        help
            Unique identifier for this collector node.

endmenu
