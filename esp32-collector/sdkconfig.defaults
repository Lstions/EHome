# EHomeSystem ESP32 Collector - Configuration
# Default target: ESP32-C6 4MB Flash

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# MQTT
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_BUFFER_SIZE=2048
CONFIG_MQTT_TASK_STACK_SIZE=6144
CONFIG_MQTT_TASK_PRIORITY=5

# WiFi
CONFIG_ESP_WIFI_ENABLED=y

# OTA - HTTPS only
# CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP is not set

# Bootloader rollback protection
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# NVS
CONFIG_NVS_ENABLED=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Partition Table - custom with OTA dual partition
CONFIG_PARTITION_TABLE_CUSTOM=y
