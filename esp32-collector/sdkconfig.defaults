# EHomeSystem ESP32 Collector - Shared Configuration
# Console/logs on USB Serial/JTAG (both S3 and C6 support it)
# UART0 is free for user data serial port

# Console output via USB Serial/JTAG (firmware flash + logs)
# UART0 is free for user data but retains ROM bootloader download capability
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Flash bus settings shared by the supported module profiles. Flash capacity and
# partition layout are selected by config/flash/*.defaults.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# MQTT
#
# IDF 6.1 moved the MQTT client into the managed component espressif/mqtt
# (lock: 1.1.0).  CONFIG_MQTT_TRANSPORT_TCP no longer exists there -- plain TCP
# is always compiled in and the remaining transport choice is SSL/WebSocket.
# Keeping the old symbol produced an "unknown kconfig symbol" notice on every
# build while silently doing nothing, so it is dropped rather than left to look
# like it configures something.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_BUFFER_SIZE=2048
# 8192（原 6144）：MQTT 任务要在回调里跑完整条 ConfigManifest 事务，
# 其中 bus_manager 的 validate_manifest_resources 有 1792 字节栈帧
# （components/bus_manager/bus_manager.c:376），之后还有 config_mgr 的事务
# 包装与发布链。6144 对该路径余量偏薄；2026-10-04 的 status_task 栈溢出
# 证明了这类"帧 + 发布链"组合会实际崩掉设备（PANIC in
# prvTaskCheckFreeStackSpace），因此一并加厚。
CONFIG_MQTT_TASK_STACK_SIZE=8192
CONFIG_MQTT_TASK_PRIORITY=5

# WiFi
CONFIG_ESP_WIFI_ENABLED=y

# ===========================================================================
# Network sizing for a 100 Hz x 5-channel collector (WS-D / task-4)
# ===========================================================================
#
# Traffic model (why these numbers, not IDF defaults):
#   Full fit on S3 = 5 channels x 100 Hz = 500 transactions/s.
#   Each DataReport carries ~300 B raw payload.  Raw uplink payload is
#   therefore 500 x 300 B = ~150 KB/s; the design point is 300 KB/s (2x) to
#   absorb retries, ACKs, keepalive/control traffic and bursts while an OTA
#   download runs in parallel.
#   802.11n on 2.4 GHz delivers multiple Mbit/s even in a busy home mesh, so
#   the binding resource is buffering/latency, not link rate.  Values below
#   are chosen for ~4x queueing margin at 300 KB/s, not at the 150 KB/s mean:
#     - static RX 6 x ~1.6 KB = 9.6 KB of hardware DMA ring
#       -> ~32 ms of worst-case burst absorption at 300 KB/s, and it matches
#          ESP_WIFI_RX_BA_WIN=6 (IDF docs: static RX should be >= RX_BA_WIN
#          for good AMPDU compatibility).
#     - dynamic RX 16 + dynamic TX 16 -> ~25.6 KB each of Wi-Fi-layer
#       buffering (IDF peak formula p = b_rx*m_rx + b_tx*m_tx), i.e. another
#       ~85 ms of headroom at 300 KB/s.
#     - MQTT outbox limit 4096 B, QoS1 frames ~100-400 B: ~10-40
#       unacknowledged publishes can queue before backpressure -> 20-80 ms
#       of absorption at 500 Hz, matched by the 5760 B TCP window.
#   Reference: IDF Wi-Fi performance guide, "Peak Wi-Fi Dynamic Buffer" and
#   "Wi-Fi Buffer Configure".  Never below IDF range floors
#   (TCPIP recvmbox >= 6, UDP/TCP recvmbox = 6).
#
# WiFi static RX buffers (hardware DMA ring), allocated at esp_wifi_init.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
#
# WiFi dynamic RX/TX buffers (allocated from the heap on demand).
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
#
# Management/short-buffer pool: association, scan, control.  Event-driven,
# not 100 Hz; 16 is still 2.6x the IDF minimum of 6.
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
#
# lwIP TCP/IP task mailbox.  At 300 KB/s each inbound segment is one message;
# 16 entries absorb ~50 ms even at full line rate, and must stay above the
# TCP/UDP recvmbox (6).
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
#
# Per-socket budget.  At 500 Hz a socket is busy but not concurrent: one MQTT
# socket + one OTA (TLS) socket at most, plus a transient DNS socket.  6
# sockets leaves 2x protocol margin.  No listening sockets in production
# (debug TCP server off), so 2 is already generous.
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_MAX_ACTIVE_TCP=6
CONFIG_LWIP_MAX_LISTENING_TCP=2
#
# UDP: only DNS and DHCP, both request/response.  IDF hard range for this
# symbol is 6..64 (lwip/Kconfig:859-862), so 6 is the lowest admissible
# value; a value of 4 is silently clamped to 6 by kconfig.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
#
# TCP window / send buffer are deliberately NOT reduced: 5760 B is 4 x MSS
# and is the throughput-sensitive pair for the MQTT upload path.  Cutting
# them would trade RAM for p99 latency, which the 100 Hz requirement forbids.
# MQTT_BUFFER_SIZE=2048 and the 4096 B outbox limit are likewise kept.
#
# Product feature switches (2026-10-05 user decision):
#   - STA only; no SoftAP, no DHCP server, no mDNS.
#   - Never cut TLS/mbedTLS memory: TLS is a hard future requirement.
#   - WPA3 Personal stays enabled; Enterprise/OWE/SAE-PK/SoftAP-SAE off.
#   NOTE: wifi_mgr.c's no-credentials fallback still calls the SoftAP
#   provisioning path (wifi_mgr.c:110).  It links today only because the
#   default SSID is non-empty, which lets the compiler dead-strip the AP
#   branch.  With CONFIG_COLLECTOR_WIFI_SSID="" + SOFTAP_SUPPORT=n the link
#   fails on esp_netif_create_default_wifi_ap (measured, link error).
#   WS-H/task-8 must put that path behind #if CONFIG_ESP_WIFI_SOFTAP_SUPPORT
#   before first-boot provisioning is exercised with an empty SSID.
CONFIG_LWIP_DHCPS=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
# WPA3 Personal / WPA2 backward compatibility (kept explicitly; defaults we
# depend on):
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=y
CONFIG_ESP_WIFI_WPA3_COMPATIBLE_SUPPORT=y
# wifi_mgr.c keeps threshold.authmode = WIFI_AUTH_WPA2_PSK: the threshold is
# the *weakest* accepted mode, so WPA2-PSK admits WPA2-only and WPA2/WPA3
# mixed APs; raising it to WPA2_WPA3_PSK would reject WPA2-only APs
# (esp_wifi_types_generic.h:375/377).

# ===========================================================================
# BLE budget reservation (WS-H/task-8; BLE not implemented in this phase)
# ===========================================================================
# CONFIG_COLLECTOR_BLE=y is reserved for future BLE provisioning / status /
# BLE OTA and must only be enabled after the memory gate passes.
# Intended Kconfig combination (NimBLE, peripheral only, 1 connection):
#   CONFIG_BT_ENABLED=y
#   CONFIG_BT_NIMBLE_ENABLED=y
#   CONFIG_BT_CONTROLLER_ENABLED=y
#   CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
#   CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
#   CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y   # advertising while peripheral
#   CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
#   CONFIG_BT_NIMBLE_GATT_SERVER=y
#   CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
#   CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
#   CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
#   CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096   # internal RAM
# Budget: 48-64 KiB internal RAM (NimBLE host + controller + GATT server +
# one connection; no Bluedroid, no mesh, no classic BT).
# Acceptance criterion: with CONFIG_COLLECTOR_BLE=n, in the worst-case running
# state (500 txn/s + configuration transaction + log stream), internal free
# must be >= BLE budget + 8 KiB.  For the minimum budget that is
# >= 48 + 8 = 56 KiB internal free, with a largest free block large enough
# to create the BLE task stack from internal RAM.

# Memory reclaim: keep the Wi-Fi driver code in flash instead of IRAM.
#
# IDF defaults these to y ("speed optimization"). The cost is IRAM, and on
# ESP32-S3 IRAM is carved out of the same internal SRAM that the heap is built
# from (.dram0.dummy is exactly the IRAM alias), so every IRAM byte is a heap
# byte lost. ESP32-C6 has IRAM and DRAM in one sram_seg, so the tradeoff is the
# same there.
#
# This firmware is a sensor collector: one heartbeat every few seconds, plus
# occasional OTA downloads. It does not need Wi-Fi throughput, and the memory
# is worth far more than the latency. IDF documents >10 KB saved by
# ESP_WIFI_IRAM_OPT=n and >17 KB by ESP_WIFI_RX_IRAM_OPT=n.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# ESP_WIFI_EXTRA_IRAM_OPT defaults to y only on Wi-Fi 6 targets
# (`default y if SOC_WIFI_HE_SUPPORT`), so ESP32-C6 enables it while ESP32-S3
# does not. Set it explicitly so both targets reclaim the same >5 KB and the
# resulting heap is predictable per profile instead of depending on the chip.
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n

# OTA - HTTPS enabled by default (production)
CONFIG_COLLECTOR_OTA_USE_HTTPS=y
CONFIG_COLLECTOR_OTA_VERIFY_CERT=y
CONFIG_COLLECTOR_OTA_CRT_BUNDLE=y
CONFIG_COLLECTOR_OTA_ALLOW_HTTP=y

# OTA - HTTPS certificate verification
#
# IDF 6.1 renamed these into the MBEDTLS_* namespace (sdkconfig.rename maps
# ESP_CERTIFICATE_BUNDLE -> MBEDTLS_CERTIFICATE_BUNDLE).  The old names are not
# parsed at all any more, so they were dead letters: the Mozilla CA bundle that
# esp_crt_bundle_attach() needs was enabled by the Kconfig default, not by this
# file.  Use the current names so the setting is real.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Bootloader rollback protection
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=n

# NVS
#
# CONFIG_NVS_ENABLED does not exist in IDF 6.1 (it did not exist in 5.x either:
# NVS is compiled in unconditionally via the nvs_flash component).  Listed here
# it only produced an "unknown kconfig symbol" notice on every build, so it is
# removed rather than left as documentation that lies.

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# ESP-IDF v6 Log V2 is required by log_stream's esp_log link wrapper. Keep the
# production console at INFO while compiling every level through VERBOSE so the
# remote stream can raise individual tags at runtime.
CONFIG_LOG_VERSION_2=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# Partition Table - custom with OTA dual partition
CONFIG_PARTITION_TABLE_CUSTOM=y

# MQTT broker URL -- deliberately NOT a real deployment address.
#
# 192.0.2.0/24 is TEST-NET-1 (RFC 5737): reserved for documentation and
# guaranteed unroutable.  Committing a real LAN address here is what caused the
# 2026-10-01 incident -- a firmware built from the documented command silently
# pointed at a developer workstation, and the device was unreachable from
# production until a transparent proxy was installed.
#
# The real broker is supplied per-build and never committed:
#   - config/mqtt-broker.defaults   (gitignored, local override), or
#   - EXTRA_SDKCONFIG_DEFAULTS=...  (one-off override)
# build_firmware.sh refuses to produce a flashable image while this placeholder
# is still in effect, so a build that forgets to set the broker fails loudly
# rather than shipping a device that cannot connect.
CONFIG_COLLECTOR_MQTT_BROKER_URL="mqtt://192.0.2.1:1883"
CONFIG_COLLECTOR_NODE_ID="1001"

# Debug TCP Server (for parallel debugging with MQTT)
# Production default: off.  The Kconfig option stays available for
# bring-up; when off the code is #ifdef'd out of the image entirely.
CONFIG_DEBUG_TCP_ENABLED=n
CONFIG_DEBUG_TCP_PORT=8088
