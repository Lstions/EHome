menu "EHome Collector Configuration"

    menu "Model Configuration"

        # WS-A: model dimension = same SoC, with or without PSRAM.  The build
        # profile (s3p-*) forces this on; it is also visible for manual builds.
        config COLLECTOR_PSRAM
            bool "Model has PSRAM (ESP32-S3 only)"
            default n
            depends on IDF_TARGET_ESP32S3
            help
                Select for the PSRAM variant of the ESP32-S3 (profiles s3p-*).
                The model name reported at Hello/ResourceReport becomes
                esp32s3p when PSRAM is also detected at runtime; a board
                without working PSRAM degrades to esp32s3.
                Only ESP-IDF targets with PSRAM support expose this option.

        config COLLECTOR_IPV6
            bool "Enable IPv6"
            default y
            # Link the product switch to the lwIP stack it is supposed to
            # control, so the two can never drift apart:
            #   LWIP_IPV6           -- the IPv6 stack itself
            #   LWIP_IPV6_AUTOCONFIG -- SLAAC (bounded by LWIP_IPV6); IDF 6.1
            #       defaults it to n (lwip/Kconfig:522-525).  Without SLAAC the
            #       device only gets a link-local address and never the global
            #       address from a Router Advertisement, so "IPv6 reachable"
            #       does not hold.
            # select is the single source of truth here; no defaults file
            # needs to repeat these values.
            select LWIP_IPV6
            select LWIP_IPV6_AUTOCONFIG
            help
                Enable IPv6 support with SLAAC.  IPv6 is part of the required
                feature set for this product; keep enabled unless building a
                constrained development image.

                The selects above only guarantee the y direction: while this
                option is on, LWIP_IPV6 and LWIP_IPV6_AUTOCONFIG are both
                forced y.  select cannot force n, so switching this option
                off does NOT turn the lwIP IPv6 stack off -- a future profile
                that ships with IPv6 disabled MUST explicitly pin
                CONFIG_LWIP_IPV6=n in its defaults file.

        config COLLECTOR_BLE
            bool "Enable BLE (reserved for future provisioning)"
            default n
            help
                Reserved budget switch for future BLE provisioning / status /
                OTA.  Not implemented in this phase: enabling it only records
                the intent and reserves 48-64 KiB of internal RAM in the
                capacity plan.

    endmenu

    menu "OTA Configuration"

        config COLLECTOR_OTA_USE_HTTPS
            bool "Use HTTPS for OTA updates"
            default y
            help
                Enable HTTPS for OTA firmware downloads.

        config COLLECTOR_OTA_VERIFY_CERT
            bool "Verify server certificate (HTTPS)"
            default y
            depends on COLLECTOR_OTA_USE_HTTPS
            help
                Verify the OTA server's TLS certificate.

        config COLLECTOR_OTA_CRT_BUNDLE
            bool "Use Mozilla CA certificate bundle"
            default y
            depends on COLLECTOR_OTA_VERIFY_CERT
            help
                Use the built-in Mozilla CA bundle for verification.

        config COLLECTOR_OTA_CUSTOM_CERT
            bool "Use custom CA certificate"
            default n
            depends on COLLECTOR_OTA_VERIFY_CERT && !COLLECTOR_OTA_CRT_BUNDLE
            help
                Embed a custom CA PEM for private/self-signed servers.

        config COLLECTOR_OTA_EXPECTED_CN
            string "Expected certificate Common Name"
            default ""
            depends on COLLECTOR_OTA_VERIFY_CERT
            help
                If non-empty, verify the server cert CN matches this value.

        config COLLECTOR_OTA_ALLOW_HTTP
            bool "Allow plain HTTP OTA (development only)"
            default n
            help
                Allow downloading firmware over plain HTTP.
                WARNING: No encryption, no authentication. Dev use only.

    endmenu

endmenu

menu "Debug Configuration"

    config DEBUG_TCP_ENABLED
        bool "Enable TCP Transport for debugging"
        default n
        help
            Enable TCP transport layer that runs in parallel with MQTT.
            This allows testing and debugging via direct TCP connection.
            Disable for production use to save resources.

    config DEBUG_TCP_PORT
        int "TCP Transport port number"
        depends on DEBUG_TCP_ENABLED
        default 8088
        range 1024 65535
        help
            Port number for TCP transport server.
            Default is 8088.

endmenu
